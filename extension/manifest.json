{
  "manifest_version": 3,
  "name": "FootageGrab",
  "version": "0.3.0",
  "description": "Mark In/Out on YouTube — or one-click grab from X, Reddit, TikTok and more — straight into your Premiere footage folder.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "grab-page": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Grab the video on the current page"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/time.js",
        "content/state.js",
        "content/toasts.js",
        "content/namer.js",
        "content/markers.js",
        "content/overlay.js",
        "content/hotkeys.js",
        "content/main.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://new.reddit.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "content/time.js",
        "content/toasts.js",
        "content/namer.js",
        "content/sites/resolve.js",
        "content/sites/core.js",
        "content/sites/x.js",
        "content/sites/reddit.js",
        "content/sites/tiktok.js",
        "content/sites/instagram.js"
      ],
      "css": ["content/content.css", "content/sites/sites.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
